generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  color     String
  pushSubscription String?
  createdAt DateTime @default(now())

  ownedEvents  Event[]    @relation("EventOwner")
  helperEvents Event[]    @relation("EventHelper")
  weekPlans    WeekPlan[]
}

model Event {
  id         String    @id @default(uuid())
  title      String
  type       EventType
  startTime  DateTime
  endTime    DateTime
  isCritical Boolean   @default(false)
  helperNote String?
  createdAt  DateTime  @default(now())

  ownerId  String
  owner    User    @relation("EventOwner", fields: [ownerId], references: [id])
  helperId String?
  helper   User?   @relation("EventHelper", fields: [helperId], references: [id])
}

enum EventType {
  COURSE
  LATE_RETURN
  OUTING
  CHILDCARE
  OTHER
}

model WeekPlan {
  id        String   @id @default(uuid())
  weekStart DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  meals       Meal[]
  groceryList GroceryList?

  @@unique([weekStart])
}

model Meal {
  id          String   @id @default(uuid())
  dayOfWeek   Int
  slot        MealSlot
  customLabel String?

  weekPlanId String
  weekPlan   WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
}

enum MealSlot {
  LUNCH
  DINNER
}

model Recipe {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  ingredients RecipeIngredient[]
  meals       Meal[]
}

model RecipeIngredient {
  id       String          @id @default(uuid())
  name     String
  quantity String
  category GroceryCategory

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

enum GroceryCategory {
  PRODUCE
  MEAT
  DAIRY
  BAKERY
  FROZEN
  PANTRY
  OTHER
}

model GroceryList {
  id        String   @id @default(uuid())
  updatedAt DateTime @updatedAt

  weekPlanId String      @unique
  weekPlan   WeekPlan    @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  items      GroceryItem[]
}

model GroceryItem {
  id            String          @id @default(uuid())
  name          String
  quantity      String?
  category      GroceryCategory
  checked       Boolean         @default(false)
  addedManually Boolean         @default(false)

  groceryListId String
  groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
}
